{% form_theme form '@CHCookieConsent/form/cookie_consent_theme.html.twig' %}

<div
    class="ch-cookie-consent p-3"
    data-controller="cookie-consent"
    data-cookie-consent-target="cookieContainer"
>
    {{ form_start(form, {
        'attr': {
            'class': 'ch-cookie-consent__form',
            'data-cookie-consent-target': 'cookieForm'
        }
    }) }}
        <div class="ch-cookie-consent__category-group" data-cookie-consent-target="cookieCategoryDetails">
            {% for child in form %}
                {% if child.vars.block_prefixes[0] !== 'button' %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        </div>
        <div class="ch-cookie-consent__btn-group mt-3">
            {# LINK BUTTON #}
            <a class="btn btn-primary me-2" href="{{ path('ConnectHolland\\CookieConsentBundle\\Controller\\CookieConsentController::reject') }}">
                {{- 'ch_cookie_consent.reject_all_cookies'|trans({}, 'CHCookieConsentBundle') -}}
            </a>
            {# FORM BUTTON #}
            {% for child in form %}
                {% if child.vars.block_prefixes[0] === 'button' %}
                    {{ form_widget(child, {
                        'attr': {
                            'class': 'btn btn-primary me-2 ch-cookie-consent__btn',
                            'data-action': 'click->cookie-consent#submitForm'
                        }
                    }) }}
                {% endif %}
            {% endfor %}
            {# LINK BUTTON #}
            <a class="btn btn-primary ms-1" href="{{ path('ConnectHolland\\CookieConsentBundle\\Controller\\CookieConsentController::reject') }}">
                {{- 'ch_cookie_consent.accept_all_cookies'|trans({}, 'CHCookieConsentBundle') -}}
            </a>
        </div>
    {{ form_end(form) }}
</div>
